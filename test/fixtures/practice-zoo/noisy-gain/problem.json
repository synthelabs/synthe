{
  "version": 1,
  "name": "noisy-gain",
  "goal": "Raise the score that measure/score.js prints.",
  "artifact": ["config.json"],
  "protect": ["measure/**"],
  "measure": { "command": "node measure/score.js {{TMP}}", "direction": "higher", "runs": 5 },
  "proposer": { "command": "node propose.mjs" },
  "budget": { "max_rounds": 6 }
}
