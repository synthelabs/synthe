{
  "version": 1,
  "name": "measure-trap",
  "goal": "Raise the throughput that measure/score.js prints.",
  "artifact": ["settings.json", "measure/**", "checks/**"],
  "protect": ["measure/**"],
  "measure": { "command": "node measure/score.js", "direction": "higher", "runs": 3 },
  "guards": ["node checks/safe.js"],
  "proposer": { "command": "node propose.mjs" },
  "budget": { "max_rounds": 8 }
}
